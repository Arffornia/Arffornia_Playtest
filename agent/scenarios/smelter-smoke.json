{
  "$comment": "A scripted playtest: the cheap, deterministic layer that runs before (and instead of) the agent when it is enough. Successful agent runs are promoted to files like this one (replayable regression).",
  "id": "smelter-smoke",
  "pr_scope": ["src/main/java/**/machine/**", "src/main/resources/data/arffornia/recipe/smelt*"],
  "env": "light",
  "world": { "template": "arffornia:playtest/flat_powered", "seed": 1, "rules": { "doDaylightCycle": false, "doWeatherCycle": false, "doMobSpawning": false } },
  "steps": [
    { "tool": "scenario", "args": { "reset": "flat_powered", "mark": "start", "record": "start" } },
    { "tool": "command", "args": { "command": "setblock 10 64 3 arffornia:smelter" } },
    { "tool": "command", "args": { "command": "give @p minecraft:raw_iron 8" } },
    { "tool": "goto", "args": { "pos": [10, 64, 6], "mode": "teleport" } },
    { "tool": "look", "args": { "pos": [10.5, 64.5, 3.5] } },
    { "tool": "use", "args": { "action": "use" } },
    { "tool": "observe", "args": {}, "expect": { "screen.class": "SmelterScreen" } },
    { "tool": "slot", "args": { "index": 36, "action": "quick_move" } },
    { "tool": "time", "args": { "until": "machine(10,64,3).output.count >= 1", "max_ticks": 400 } },
    { "tool": "assert", "args": { "kind": "machine", "label": "one ingot out", "expect": { "pos": [10, 64, 3], "output": { "item": "minecraft:iron_ingot", "min": 1 } } } },
    { "tool": "assert", "args": { "kind": "no_errors_since", "label": "clean log", "expect": "start" } },
    { "tool": "assert", "args": { "kind": "screenshot_matches", "label": "GUI looks right", "expect": { "baseline": "smelter-gui.png", "tolerance": 0.002 } } },
    { "tool": "scenario", "args": { "record": "stop" } }
  ]
}
