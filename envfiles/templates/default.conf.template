# Rendered at start by the image's envsubst step. Inputs (environment):
#   PACK_UPSTREAM     raw GitHub base of Arffornia_Provisioning (no trailing slash)
#   PROVISIONING_REF  the ref to serve: refs/heads/main, or a commit SHA for a PR
#   MOD_TAG           the release tag for the Arffornia mod: edge, pr-<n>; empty keeps `latest`
#   NGINX_LOCAL_RESOLVERS  set by the image from /etc/resolv.conf
resolver ${NGINX_LOCAL_RESOLVERS} valid=60s ipv6=off;

server {
    listen 8080;
    server_name _;

    set $upstream_base "${PACK_UPSTREAM}/${PROVISIONING_REF}";
    set $mod_tag "${MOD_TAG}";

    # Large enough for the biggest index.json and mod list (both well under 1 MiB today).
    subrequest_output_buffer_size 8m;

    # Read-only: everything else is refused before it reaches njs or GitHub.
    if ($request_method !~ ^(GET|HEAD)$) {
        return 405;
    }

    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Accept-Encoding "";
    proxy_hide_header Set-Cookie;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # What this instance serves, for `playtest status` and humans.
    location = /_pack {
        default_type application/json;
        return 200 '{"provisioningRef":"${PROVISIONING_REF}","modTag":"${MOD_TAG}"}\n';
    }

    location ~ ^/config/[^/]+/modList\.json$ {
        js_content pack.modList;
    }

    location ~ ^/config/[^/]+/index\.json$ {
        js_content pack.index;
    }

    location ~ ^/config/[^/]+/storage/ {
        js_content pack.file;
    }

    location / {
        proxy_pass $upstream_base$request_uri;
    }

    # Internal: njs subrequests (ASCII paths only: mod lists, indexes, rewritten text files).
    location ~ ^/_raw(/.*)$ {
        internal;
        proxy_pass $upstream_base$1;
    }

    location @raw {
        proxy_pass $upstream_base$request_uri;
    }
}
